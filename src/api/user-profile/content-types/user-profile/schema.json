{
  "kind": "collectionType",
  "collectionName": "user_profiles",
  "info": {
    "singularName": "user-profile",
    "pluralName": "user-profiles",
    "displayName": "Profil utilisateur",
    "description": "Profil client Nyra. accountType = classic (defaut) ou professional (tarifs herboristerie)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "accountType": {
      "type": "enumeration",
      "enum": ["classic", "professional"],
      "default": "classic",
      "required": true
    },
    "proApprovedAt": {
      "type": "datetime"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    }
  }
}
