{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Produits catalogue Nyra"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true
    },
    "ingredients": {
      "type": "text",
      "required": true
    },
    "shortDescription": {
      "type": "text"
    },
    "description": {
      "type": "richtext"
    },
    "dosage": {
      "type": "string"
    },
    "infusionTime": {
      "type": "string"
    },
    "temperature": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "botanicalName": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "price": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "compareAtPrice": {
      "type": "integer",
      "min": 0
    },
    "rating": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "reviews": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "metaTitle": {
      "type": "string",
      "maxLength": 70
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 180
    },
    "canonicalUrl": {
      "type": "string"
    },
    "canonicalPath": {
      "type": "string"
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "bgClass": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "imageUrl": {
      "type": "string",
      "required": false
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "required": true,
      "inversedBy": "products"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "products"
    },
    "variants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::variant.variant",
      "mappedBy": "product"
    }
  }
}
