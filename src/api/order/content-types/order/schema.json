{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Commandes",
    "description": "Commandes payées uniquement (créées après validation Sycapay / Stripe)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "orderNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "checkoutId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "paid", "failed", "shipped", "delivered", "cancelled", "refunded"],
      "required": true,
      "default": "pending"
    },
    "paidAt": {
      "type": "datetime",
      "description": "Date de validation paiement (CA journalier backoffice)"
    },
    "paymentProvider": {
      "type": "string",
      "default": "stripe"
    },
    "paymentIntentId": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "required": true,
      "default": "XOF"
    },
    "subtotal": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "shipping": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "total": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "customer": {
      "type": "json",
      "required": true
    },
    "shippingAddress": {
      "type": "json",
      "required": true
    },
    "billingAddress": {
      "type": "json"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    }
  }
}
