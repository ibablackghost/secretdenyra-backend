HOST=0.0.0.0
PORT=1337

# i18n — défaut FR (OBLIGATOIRE avant 1er boot avec schemas localisés,
# sinon le contenu existant peut être tagué "en")
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=fr

# PostgreSQL (production / équipe) — décommenter et adapter si tu quittes SQLite
# DATABASE_CLIENT=postgres
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=nyra
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=secret
# DATABASE_SSL=false
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# API interne backoffice (Django / proxy Next serveur) — min. 32 caractères aléatoires
BACKOFFICE_SERVICE_KEY=change-me-generate-with-openssl-rand-hex-32

# Compte professionnel — email qui reçoit les demandes (formulaire front)
PRO_ACCOUNT_REQUEST_NOTIFY_EMAIL=contact@ton-domaine.com
STRAPI_ADMIN_URL=http://localhost:1337/admin
# URL publique API (obligatoire en prod pour images /uploads vers le front)
# PUBLIC_URL=https://secretdenyra-backend-production.up.railway.app

# Email — Brevo recommandé sur Railway (SMTP Hostinger souvent bloqué)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_DEFAULT_FROM=contact@ton-domaine.com
EMAIL_DEFAULT_REPLY_TO=contact@ton-domaine.com
ORDERS_NOTIFY_EMAIL=

# Optionnel SMTP Hostinger (EMAIL_PROVIDER=nodemailer) — local
# EMAIL_SMTP_HOST=smtp.hostinger.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_USER=contact@ton-domaine.com
# EMAIL_SMTP_PASS=

# Sycapay (mTLS — certificats hors git)
SYCAPAY_BASE_URL=https://ops.sycapay.com/coresystem/part/api
SYCAPAY_LOGIN_API=
SYCAPAY_MDP_API=
# Local : chemins fichiers
SYCAPAY_CA_CERT_PATH=./ca.crt
SYCAPAY_CLIENT_CERT_PATH=./client.crt
SYCAPAY_CLIENT_KEY_PATH=./client.key
# Railway : PEM en base64 (prioritaire si renseigné)
# SYCAPAY_CA_CERT_B64=
# SYCAPAY_CLIENT_CERT_B64=
# SYCAPAY_CLIENT_KEY_B64=
# Uniquement ton domaine front (jamais domaine Sycapay)
SYCAPAY_SUCCESS_URL=http://localhost:5173/checkout/payment/return?result=success
SYCAPAY_FAILED_URL=http://localhost:5173/checkout/payment/return?result=cancel
# Prod : HMAC obligatoire (+ secret partagé dashboard Sycapay / Railway). NONE = local test only.
SYCAPAY_WEBHOOK_AUTH=HMAC
SYCAPAY_WEBHOOK_SECRET=
